<?xml version="1.0" encoding="UTF-8"?>
<!-- Maps RenderModification types received from TCP clients to a different type
     before they are published to DDS (and so to other TCP clients). -->
<RenderModificationMappings>
   <Map from="ET_TUBE_CORRECT" to="MASK_INSERT_ET_TUBE_CORRECT"/>
   <Map from="Intubation" fromState="Tracheal" to="MASK_INSERT_ET_TUBE_CORRECT" toState="on"/>
   <Map from="Intubation" fromState="Esophageal" to="MASK_INSERT_ET_TUBE_ESOPH" toState="on"/>
   <Map from="Intubation" fromState="RMS" to="MASK_INSERT_ET_TUBE_MS" toState="on"/>
</RenderModificationMappings>
